# ──────────────────────────────────────────────
# Crochet PeakZ — environment variables
# ──────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values.
# In Vercel, add the same variables under
# Project → Settings → Environment Variables.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser. Never put secrets in those.

# ── Site ──────────────────────────────────────
# The public URL of your deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://crochetpeakz.com

# ── Supabase (database / auth / edge functions) ──
# Found in your Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Meta / Facebook Pixel ─────────────────────
# Your Meta Pixel ID for visit tracking and ad measurement.
# Leave blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Contact email (edge function secrets) ─────
# These are NOT public — set them in Supabase as
# edge function secrets, NOT in Vercel.
#   supabase secrets set RESEND_API_KEY=re_xxxxx
#   supabase secrets set RESEND_FROM_EMAIL="Crochet PeakZ <hello@crochetpeakz.com>"
#   supabase secrets set CONTACT_EMAIL=hello@crochetpeakz.com
