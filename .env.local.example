# ──────────────────────────────────────────────
# Crochet PeakZ — environment variables
# ──────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values.
# In Vercel, add the same variables under
# Project → Settings → Environment Variables.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser. Never put secrets in those.

# ── Site ──────────────────────────────────────
# The public URL of your deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://crochetpeakz.tech


# ── Meta / Facebook Pixel ─────────────────────
# Your Meta Pixel ID for visit tracking and ad measurement.
# Leave blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Contact form (Resend) ─────────────────────
# Create an API key at https://resend.com/api-keys and
# verify the crochetpeakz.tech domain in Resend first.
RESEND_API_KEY=re_xxxxx
CONTACT_EMAIL=hello@crochetpeakz.tech
# Must use a verified domain in Resend.
CONTACT_FROM_EMAIL="Crochet PeakZ <hello@crochetpeakz.tech>"

# ── Contact form rate limiting (recommended) ──
# Use Upstash Redis (or Vercel KV) so the 1 submission
# per 30 minutes limit is shared across server instances.
# Without these, the limit falls back to in-memory storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
